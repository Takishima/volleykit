{
  "name": "@volleykit/mobile",
  "version": "1.33.0",
  "expo": {
    "install": {
      "exclude": [
        "react",
        "jest",
        "@types/jest"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-widgetkit"
        ]
      }
    }
  },
  "description": "VolleyKit React Native mobile app",
  "type": "module",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --max-warnings 0 --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "knip": "knip",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-persist-client": "^5.103.1",
    "@volleykit/shared": "workspace:*",
    "date-fns": "^4.4.0",
    "expo": "~57.0.23",
    "expo-calendar": "~57.0.4",
    "expo-constants": "~57.0.16",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.14",
    "nativewind": "^4.2.7",
    "ojp-sdk-next": "^0.21.4",
    "react": "^19.3.0",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-widgetkit": "^1.0.9",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "jest": "^30.5.1",
    "knip": "^6.37.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
