{
  "name": "@volleykit/mobile",
  "version": "1.34.0",
  "expo": {
    "install": {
      "exclude": [
        "react",
        "jest",
        "@types/jest"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-widgetkit"
        ]
      }
    }
  },
  "description": "VolleyKit React Native mobile app",
  "type": "module",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --max-warnings 0 --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "knip": "knip",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "@volleykit/shared": "workspace:*",
    "date-fns": "^4.4.0",
    "expo": "~58.0.7",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.10",
    "expo-font": "~58.0.7",
    "expo-linking": "~58.0.11",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.13",
    "expo-notifications": "~58.1.2",
    "expo-router": "~58.0.17",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "expo-task-manager": "~58.0.11",
    "nativewind": "^4.2.7",
    "ojp-sdk-next": "^0.21.4",
    "react": "^19.3.0",
    "react-native": "0.88.0-rc.4",
    "react-native-android-widget": "^0.22.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-widgetkit": "^1.0.9",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@react-native/metro-config": "0.88.0-rc.4",
    "@types/jest": "^30.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jest": "^30.5.2",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
