{
  "name": "@volleykit/mobile",
  "version": "1.32.0",
  "expo": {
    "install": {
      "exclude": [
        "react"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-widgetkit"
        ]
      }
    }
  },
  "description": "VolleyKit React Native mobile app",
  "type": "module",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --max-warnings 0 --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "knip:check": "knip",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@volleykit/shared": "workspace:*",
    "date-fns": "^4.4.0",
    "expo": "~57.0.18",
    "expo-calendar": "~57.0.2",
    "expo-constants": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.14",
    "nativewind": "^4.2.6",
    "ojp-sdk-next": "^0.21.4",
    "react": "^19.2.8",
    "react-native": "0.83.4",
    "react-native-android-widget": "^0.22.1",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-widgetkit": "^1.0.9",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jest": "^30.5.0",
    "knip": "^6.33.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
