{
  "name": "volleykit-proxy",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix --prune-suppressions",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc --noEmit",
    "knip": "knip",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.13.0",
    "eslint-plugin-oxlint": "^1.89.0",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
