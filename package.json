{
  "name": "volleykit",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status",
    "generate:api": "pnpm --filter volleykit-web run generate:api",
    "generate:tokens": "node scripts/sync-style-tokens.js",
    "generate:tokens:check": "node scripts/sync-style-tokens.js --check",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md,astro}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md,astro}\"",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "mobile:start": "pnpm --filter @volleykit/mobile run start",
    "mobile:ios": "pnpm --filter @volleykit/mobile run ios",
    "mobile:android": "pnpm --filter @volleykit/mobile run android",
    "shared:build": "pnpm --filter @volleykit/shared run build",
    "shared:test": "pnpm --filter @volleykit/shared run test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.3.1",
      "@types/react": "^19.3.0",
      "serialize-javascript@<7.0.5": "^7.0.5",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "sharp@<0.35.0": "^0.35.0",
      "uuid@<11.1.1": "^11.1.1",
      "ojp-sdk-next>axios": "^1.18.0",
      "ojp-sdk-next>fast-xml-parser": "^5.11.1",
      "undici@<7.30.1": "^7.30.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
