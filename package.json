{
  "name": "volleykit",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status",
    "generate:api": "pnpm --filter volleykit-web run generate:api",
    "generate:tokens": "node scripts/sync-style-tokens.js",
    "generate:tokens:check": "node scripts/sync-style-tokens.js --check",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md,astro}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md,astro}\"",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "mobile:start": "pnpm --filter @volleykit/mobile run start",
    "mobile:ios": "pnpm --filter @volleykit/mobile run ios",
    "mobile:android": "pnpm --filter @volleykit/mobile run android",
    "shared:build": "pnpm --filter @volleykit/shared run build",
    "shared:test": "pnpm --filter @volleykit/shared run test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/react": "^19.2.18",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.2.8",
      "@types/react": "^19.2.18",
      "axios": "^1.18.0",
      "fast-xml-parser": "^5.11.1",
      "serialize-javascript@<7.0.5": ">=7.0.5",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "shell-quote@<1.9.0": ">=1.9.0",
      "ws@>=7.0.0 <7.5.11": ">=7.5.11",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "svgo@>=4.0.0 <4.0.2": ">=4.0.2",
      "@babel/core@<7.29.6": "^7.29.6"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
